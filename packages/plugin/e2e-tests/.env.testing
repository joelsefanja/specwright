# Base Environment Configuration
BASE_ENV=qat
BASE_URL=http://localhost:5173
NODE_ENV=test

# Split-auth (optional) — set AUTH_BASE_URL ONLY when signin only works on a
# different host than BASE_URL (e.g. you want tests + coverage to run against
# a local dev server, but real auth lives on a hosted environment). The auth
# strategy will sign in at AUTH_BASE_URL, then rewrite the captured
# storageState so localStorage tokens are applied at BASE_URL. Cookies that
# don't match BASE_URL are stripped. Leave commented to use single-origin auth.
# AUTH_BASE_URL=https://auth.example.com

# Browser Configuration
HEADLESS=true
BROWSER=chromium
# CHROME_ARGS — comma-separated launch flags. When using split-auth across
# different origins, append --disable-web-security,--disable-features=IsolateOrigins
# so the local app can call hosted backends without CORS rejection.
CHROME_ARGS="--no-sandbox,--disable-dev-shm-usage"

# Reports Configuration
CUCUMBER_REPORT_PATH="reports/cucumber-bdd/report.json"
CODEGEN_OUTPUT_PATH="e2e-tests/playwright/generated"

# Test Configuration
TEST_TIMEOUT=120000

# Visual Testing Configuration
ENABLE_SCREENSHOTS=true
ENABLE_VIDEO_RECORDING=true
RETAIN_VIDEO_ON_SUCCESS=false
ENABLE_TRACING=false

# Code Coverage (V8 native — requires localhost dev server for source maps)
# Enabled automatically by `pnpm test:bdd:coverage`. Set true to also enable
# for normal `pnpm test:bdd` runs (slower).
ENABLE_COVERAGE=false
# Coverage exclusions — comma-separated substring patterns
# Examples: src/api/,src/store/,.stories.,src/legacy/
COVERAGE_EXCLUDE=
# Coverage source roots — comma-separated directories to index for path mapping
# Default is `src`. Override for Next.js App Router (`app`), monorepos
# (`packages/web/src`), or multi-root layouts (`src,lib`).
COVERAGE_SOURCE_ROOTS=src

# Authentication Strategy
# Strategies: email-password | oauth | none
# - email-password: two-step login (email → password → optional 2FA)
# - oauth: click-based OAuth or mock sign-in button
# - none: skip authentication entirely
AUTH_STRATEGY=email-password

# Test Credentials (email-password and oauth strategies)
# TEST_USER_EMAIL=your-test-email@example.com
# TEST_USER_PASSWORD=your-test-password   # email-password only
# TEST_2FA_CODE=                          # 2FA OTP code (email-password + 2FA only; remove if unused)

# OAuth Strategy Configuration (only needed when AUTH_STRATEGY=oauth)
# OAUTH_STORAGE_KEY=your-localStorage-key  # preferred: bypasses OAuth popup
# OAUTH_SIGNIN_PATH=/signin                # path to sign-in page (default: /signin)
# OAUTH_BUTTON_TEST_ID=google-signin-button # fallback: click-based sign-in button
# OAUTH_POST_LOGIN_URL=**/                 # URL pattern after login (default: **/)

# Test User Identity (oauth strategy)
# TEST_USER_NAME=                          # display name (optional — derived from email if blank)
# TEST_USER_PICTURE=                       # avatar URL or data URI (optional — SVG initials auto-generated if blank)

# Build Environment
VITE_BUILD_ENVIRONMENT=testing
