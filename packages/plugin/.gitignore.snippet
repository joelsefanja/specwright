# Add these lines to your project's .gitignore

# Specwright bootstrap sentinel (written during install, deleted on completion)
.bootstrapping

# Specwright runtime data (pipeline timestamps, etc.)
.specwright/*
!.specwright/.gitkeep

# Claude Code (user-specific settings, not tracked)
.claude/settings.local.json

# Agent memory (runtime data, populated per-project)
.claude/agent-memory/

# playwright-bdd generated specs
.features-gen/

# E2E auth and test data
e2e-tests/playwright/auth-storage/.auth/user.json
e2e-tests/playwright/test-data/*.json
e2e-tests/playwright/test-data/**/*.json

# Playwright MCP screenshots
.playwright-mcp/

# Reports
reports/cucumber-bdd/*
reports/playwright/*
reports/json/*
reports/screenshots/*
reports/coverage/*
test-results/allure/*

# E2E coverage raw V8 data (temporary, merged into reports/coverage/)
.raw-coverage/

# Playwright per-scenario artifacts (videos, traces, failure screenshots).
# Keep the test-results/ directory itself tracked (via .gitkeep) but
# ignore every file inside — they are large and regenerated on every run.
test-results/*
!test-results/.gitkeep
