{
  "name": "@specwright/ui-audit",
  "version": "0.1.0",
  "private": true,
  "description": "Deterministic UI audit helpers for layout, copy, font, theme, and motion checks.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./playwright": {
      "types": "./dist/playwright.d.ts",
      "default": "./dist/playwright.js"
    }
  },
  "bin": {
    "specwright-ui-audit": "dist/cli.js"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "test:smoke": "pnpm run build && node scripts/smoke.mjs"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.40.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@types/node": "^22.19.19",
    "typescript": "^5.9.3"
  }
}
