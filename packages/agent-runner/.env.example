# Example env for switching LLM provider for Specwright agent-runner
# Provider choices: anthropic (default), openai, ollama
# For Ollama, run Ollama locally and use the default base URL http://localhost:11434/v1

# Provider name (anthropic | openai | ollama)
SPECWRIGHT_LLM_PROVIDER=ollama

# Model name to request from the provider
# - anthropic: e.g. claude-sonnet-4-6
# - openai: e.g. gpt-4o or gpt-4o-mini
# - ollama: e.g. qwen2.5, mistral, etc.
SPECWRIGHT_MODEL=claude-sonnet-4-6

# Optional: override the provider base URL (useful for OpenRouter, Ollama, Local AI gateways)
SPECWRIGHT_LLM_BASE_URL=http://localhost:11434/v1

# Optional: API key for provider (if required). Ollama accepts any string, so "ollama" works as a dummy.
SPECWRIGHT_LLM_API_KEY=ollama
