{
  "name": "@specwright/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Specwright desktop app",
  "repository": {
    "type": "git",
    "url": "https://github.com/SanthoshDhandapani/specwright"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test:e2e": "playwright test",
    "test:contrast": "node scripts/check-theme-contrast.mjs",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "clean": "rm -rf out dist"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-markdown": "^0.12.8",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/mcp": "^0.0.75",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@specwright/agent-runner": "workspace:*",
    "@specwright/plugin": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "claude-runner": "^0.5.1",
    "cmdk": "^1.1.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.2.4",
    "markitdown-mcp-npx": "^1.0.3",
    "motion": "^12.40.0",
    "react-resizable-panels": "^4.11.2",
    "react-zoom-pan-pinch": "^4.0.3",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "wcag-contrast": "^3.0.0",
    "zustand": "^5.0.13"
  }
}
