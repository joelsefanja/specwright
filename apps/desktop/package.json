{
  "name": "@specwright/desktop",
  "version": "0.2.0",
  "private": true,
  "description": "Specwright desktop app",
  "repository": {
    "type": "git",
    "url": "https://github.com/SanthoshDhandapani/specwright"
  },
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "dev:browser": "electron-vite --rendererOnly",
    "build": "electron-vite build",
    "test:e2e": "pnpm run test:e2e:smoke",
    "test:e2e:show": "set SPECWRIGHT_E2E_SHOW=1&& playwright test e2e-tests/run-tests-workflow.e2e.spec.ts",
    "test:e2e:smoke": "playwright test e2e-tests/run-tests-workflow.e2e.spec.ts",
    "test:e2e:demo": "playwright test e2e-tests/specwright-readme-file-flow.e2e.spec.ts",
    "test:e2e:all": "playwright test",
    "test:vitest": "vitest run --config vitest/vitest.workspace.ts",
    "test:unit": "vitest run --config vitest/vitest.workspace.ts --project unit --passWithNoTests",
    "test:component": "vitest run --config vitest/vitest.workspace.ts --project component --passWithNoTests",
    "test:integration": "vitest run --config vitest/vitest.workspace.ts --project integration",
    "test:contrast": "node scripts/check-theme-contrast.mjs",
    "test:ui-audit": "pnpm run test:ui-audit:package && pnpm run test:ui-audit:electron",
    "test:ui-audit:package": "pnpm --filter @specwright/ui-audit test:smoke",
    "test:ui-audit:electron": "playwright test e2e-tests/ui-audit.e2e.spec.ts",
    "ts:diagnostics": "pnpm --filter @specwright/ui-audit build && specwright-ui-audit ts --project tsconfig.node.diagnostics.json --output test-results/ts-diagnostics.json",
    "test:report": "node scripts/open-test-report.cjs",
    "report:allure": "node scripts/open-test-report.cjs",
    "preview": "electron-vite preview",
    "pack": "electron-vite build && electron-builder --dir",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac --publish never",
    "dist:win": "electron-vite build && electron-builder --win --publish never",
    "dist:linux": "electron-vite build && electron-builder --linux --publish never",
    "clean": "rm -rf out dist"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "@ai-sdk/mcp": "^1.0.36",
    "@ai-sdk/openai": "^1.1.19",
    "@anthropic-ai/claude-agent-sdk": "^0.3.150",
    "@assistant-ui/react": "^0.12.24",
    "@assistant-ui/react-markdown": "^0.12.8",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@phosphor-icons/react": "^2.1.10",
    "@playwright/mcp": "^0.0.75",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@specwright/agent-runner": "workspace:*",
    "@specwright/plugin": "workspace:*",
    "@tanstack/react-query": "^5.100.14",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "ai": "^6.0.168",
    "claude-runner": "^0.5.1",
    "cmdk": "^1.1.1",
    "electron-store": "^10.1.0",
    "electron-updater": "^6.8.3",
    "framer-motion": "^12.38.0",
    "idb-keyval": "^6.2.4",
    "markitdown-mcp-npx": "^1.0.3",
    "motion": "^12.40.0",
    "node-pty": "^1.1.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.11.2",
    "react-zoom-pan-pinch": "^4.0.3",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.7",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "1.59.1",
    "@specwright/ui-audit": "workspace:*",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.19.19",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "allure": "^3.8.2",
    "allure-playwright": "^3.9.0",
    "allure-vitest": "^3.9.0",
    "autoprefixer": "^10.5.0",
    "electron": "^33.4.11",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "jsdom": "^27.4.0",
    "postcss": "^8.5.15",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "vitest": "^4.0.15",
    "wcag-contrast": "^3.0.0",
    "zustand": "^5.0.13"
  }
}
